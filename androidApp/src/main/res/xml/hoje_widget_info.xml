<?xml version="1.0" encoding="utf-8"?>
<!-- targetCell* only apply on API 31+; older launchers use minWidth/minHeight.
     previewImage is drawn by WidgetPreviewImagesTest (recordRoborazziDebug). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_hoje_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:previewImage="@drawable/widget_hoje_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard"
    tools:ignore="UnusedAttribute" />
